# LLM provider. Use any LangChain provider:model your environment supports.
MODEL_NAME=openai:gpt-4.1-mini
EMBEDDING_MODEL=openai:text-embedding-3-small
OPENAI_API_KEY=replace-me

# Persistent LangGraph checkpoints + LangMem long-term store.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/value_agent?sslmode=disable

# SEC requires an identifying User-Agent for automated requests.
SEC_USER_AGENT=ValueInvestingAgent/0.1 your.email@example.com

# Observability.
LANGFUSE_PUBLIC_KEY=pk-lf-1234567890
LANGFUSE_SECRET_KEY=sk-lf-1234567890
LANGFUSE_HOST=http://localhost:3000

# Position sizing defaults used when the user only supplies a ticker.
DEFAULT_PORTFOLIO_VALUE=10000
MAX_POSITION_PCT=0.05
FIRST_TRANCHE_PCT=0.25

# Prompt lifecycle controls.
PROMPT_NAME=value_investing_screening_prompt
AUTO_PROMPT_OPTIMIZATION=true
PROMPT_OPTIMIZER_KIND=prompt_memory
